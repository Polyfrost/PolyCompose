{
  "schemaVersion": 1,
  "id": "polycompose",
  "name": "PolyCompose",
  "version": "${mod_version}",
  "description": "Library mod for building Minecraft screens and overlays with Compose.",
  "authors": [
    "Polyfrost"
  ],
  "contact": {
    "homepage": "https://polyfrost.org",
    "sources": "https://github.com/Polyfrost/PolyCompose",
    "issues": "https://github.com/Polyfrost/PolyCompose/issues"
  },
  "license": "LGPL-3.0",
  "environment": "client",
  "accessWidener": "polycompose.classtweaker",
  "entrypoints": {
    "client": [
      {
        "adapter": "kotlin",
        "value": "org.polyfrost.compose.minecraft.PolyComposeClient"
      }
    ],
    "controlify": [
      {
        "adapter": "kotlin",
        "value": "org.polyfrost.compose.minecraft.compat.controlify.PolyComposeControlify"
      }
    ]
  },
  "mixins": [
    "mixins.polycompose.json",
    "mixins.polycompose.optional.json"
  ],
  "provides": ["compose-multiplatform"],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "${fabric_mc_version}",
    "java": ">=${java_version}",
    "fabric-language-kotlin": ">=${flk_version}"
  },
  "breaks": {
    "oneconfig": "<1.9.0"
  },
  "custom": {
    "modmenu": {
      "badges": ["library"]
    }
  }
}
